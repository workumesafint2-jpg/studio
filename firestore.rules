rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * Institutional Security Rules v11.0
     * Fully open for production resilience as per user request.
     * Prevents permission errors during Base64 file uploads.
     */
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}