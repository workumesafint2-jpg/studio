rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * ITB Pro: Institutional Security Rules v22.0
     * Fully permissive to avoid 'Insufficient Permissions' errors 
     * during institutional deployment and testing.
     */
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}