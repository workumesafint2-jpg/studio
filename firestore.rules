
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * Institutional Security Rules v4.2.0
     * - Admin (workumesaifnt9@gmail.com): Full access.
     * - Owner: Can delete their own documents.
     * - Auth User: Can read, create, and download.
     */
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.email == 'workumesaifnt9@gmail.com');
    }

    function isOwner(data) {
      return isAuthenticated() && (request.auth.uid == data.uploaderId);
    }

    match /documents/{documentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin() || isOwner(resource.data);
      allow delete: if isAdmin() || isOwner(resource.data);
    }

    match /feedback/{feedbackId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isOwner(resource.data);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }
  }
}
